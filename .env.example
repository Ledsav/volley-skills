VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (reCAPTCHA v3) site key. Optional. When set (and not running against
# the emulator) the app sends App Check tokens. See
# docs/superpowers/runbooks/2026-09-09-quota-protection-setup.md.
VITE_APPCHECK_RECAPTCHA_KEY=

# Local dev against the emulators: `npm run emulator`, then start the app with this set.
VITE_USE_EMULATOR=
