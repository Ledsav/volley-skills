# Firebase web config used by `vite build` (production mode).
#
# These identifiers are NOT secrets. The security boundary is Firestore Security
# Rules + (later) App Check — see app design spec §11 and docs/PRODUCTION-READINESS.md.
# The repo is public by design, so committing them here is deliberate: it keeps
# the deploy workflow free of six otherwise-pointless GitHub secrets. Same values
# as the local .env.local.
VITE_FIREBASE_API_KEY=AIzaSyBKS1H5BBGXRx5Kmi-tTQ1XrmFRSguajLo
VITE_FIREBASE_AUTH_DOMAIN=volley-skills.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=volley-skills
VITE_FIREBASE_STORAGE_BUCKET=volley-skills.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=370161720575
VITE_FIREBASE_APP_ID=1:370161720575:web:30afe72d42378bd75b40ca

# App Check reCAPTCHA site key is intentionally unset for now (lean v1). When it
# is set here and re-deployed, the app starts sending App Check tokens. See the
# quota-protection runbook.
VITE_APPCHECK_RECAPTCHA_KEY=
