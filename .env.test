# Dummy Firebase config for the test run (`vitest` loads this in test mode).
# Not real credentials — the point is only that `src/firebase/config.ts` can call
# getAuth()/getFirestore() at import time without throwing `auth/invalid-api-key`.
# Component/unit tests mock the Firebase SDK; nothing here reaches a network.
# Committed so CI (which has no .env.local) runs the suite the same as local.
VITE_FIREBASE_API_KEY=AIzaSyTEST_dummy_key_not_real_000000000000
VITE_FIREBASE_AUTH_DOMAIN=demo-volley-skills.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-volley-skills
VITE_FIREBASE_STORAGE_BUCKET=demo-volley-skills.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
