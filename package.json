{
  "name": "volley-skills-app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulator": "node scripts/seed/dev.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run --config vitest.rules.config.ts\"",
    "emulator": "node scripts/seed/emulator.mjs",
    "seed:emulator": "node scripts/seed/seed.mjs --emulator --reset",
    "seed:clubs": "node scripts/seed/seedClubs.mjs",
    "seed:library": "node scripts/seed/seedLibrary.mjs",
    "seed:numbers": "node scripts/seed/applyNumbers.mjs",
    "seed:match": "node scripts/seed/seedMatch.mjs && vite-node scripts/seed/backfillSummaries.ts",
    "seed:men1": "node scripts/seed/seedMen1.mjs && node scripts/seed/seedMatch.mjs --team seed-men-1 && vite-node scripts/seed/backfillSummaries.ts",
    "seed:prod": "node scripts/seed/seed.mjs --prod",
    "seed:export-prod-players": "node scripts/seed/exportProdPlayers.mjs",
    "seed:import-players": "node scripts/seed/importPlayers.mjs",
    "backup": "node scripts/ops/backup.mjs",
    "backup:keygen": "node scripts/ops/backupKeygen.mjs",
    "backup:restore": "node scripts/ops/restore.mjs",
    "backup:prune": "node scripts/ops/prune.mjs",
    "backup:weekly": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ops/weekly-backup.ps1",
    "backup:task": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ops/backup-task.ps1",
    "key:encrypt": "node scripts/ops/encryptKey.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.1.1",
    "@use-gesture/react": "^10.3.1",
    "fflate": "^0.8.3",
    "firebase": "^12.18.0",
    "lucide-react": "^1.41.0",
    "pdfmake": "^0.3.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.0.0",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "exceljs": "^4.4.0",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.34.1",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.5"
  }
}
